  "info": {
    "_postman_id": "af0142a6-b117-45e8-9a9b-89895ec9fb71",
    "name": "Aflac Enterprise Connect Claims Policies API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Aflac Enterprise Connect (AEC) API enables benefits administrators, HR platforms, and third-party enrollment systems to integrate with Aflac's supplemental insurance platform. It provides REST API access to benefits enrollment, policy management, claims status, and eligibility verification for group and individual supplemental insurance products.\n\nContact Support:\n Name: Aflac Enterprise Connect Support",
      "type": "text/plain"
    }
